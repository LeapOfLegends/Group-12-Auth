{
  "info": {
    "name": "Group-12 Auth (NestJS)",
    "description": "Set baseUrl (this service), backendUrl (Group-12-Backend) and the existing super admin's email/password in the collection variables, then run top to bottom. Request 2 creates a real admin row through the backend, so use a unique admin-domain email. Request 7 creates a real client row, so use a unique client email and SSN. Passwords need 12+ characters with upper, lower, number and special character. Tokens are saved to collection variables; clear passwords and tokens before sharing. Request 10 logs the client out by revoking its refresh token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "backendUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "superAdminEmail", "value": "", "type": "string" },
    { "key": "superAdminPassword", "value": "", "type": "string" },
    { "key": "superAdminToken", "value": "", "type": "string" },
    { "key": "superAdminRefreshToken", "value": "", "type": "string" },
    { "key": "newAdminEmail", "value": "", "type": "string" },
    { "key": "newAdminPassword", "value": "", "type": "string" },
    { "key": "newAdminRole", "value": "operations", "type": "string" },
    { "key": "newAdminToken", "value": "", "type": "string" },
    { "key": "clientEmail", "value": "", "type": "string" },
    { "key": "clientPassword", "value": "", "type": "string" },
    { "key": "clientRefreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login (super admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Admins and clients share this endpoint; an admin-domain email is checked against the admins table. The super admin's token is saved for request 2."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "pm.test('JWT and role are returned', () => {",
        "  pm.expect(body.accessToken).to.be.a('string');",
        "  pm.expect(body.admin.role).to.eql('super_admin');",
        "  pm.expect(body.admin).not.to.have.property('passwordHash');",
        "});",
        "if (pm.response.code === 200) {",
        "  pm.collectionVariables.set('superAdminToken', body.accessToken);",
        "  pm.collectionVariables.set('superAdminRefreshToken', body.refreshToken);",
        "}"
      ] } }]
    },
    {
      "name": "2. Register admin (Group-12-Backend, as super admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
        "url": "{{backendUrl}}/admins",
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Admin\",\n  \"email\": \"{{newAdminEmail}}\",\n  \"password\": \"{{newAdminPassword}}\",\n  \"role\": \"{{newAdminRole}}\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Runs against the Spring Boot backend, which must share JWT_SECRET and ADMIN_EMAIL_DOMAINS with this service. Set newAdminRole to super_admin, operations or finance and use an admin-domain email."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('Register returns 201', () => pm.response.to.have.status(201));",
        "pm.test('Role stored and no password exposed', () => {",
        "  pm.expect(body.role).to.eql(pm.collectionVariables.get('newAdminRole'));",
        "  pm.expect(body).not.to.have.property('passwordHash');",
        "});"
      ] } }]
    },
    {
      "name": "3. Login (new admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{newAdminEmail}}\",\n  \"password\": \"{{newAdminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Proves this service verifies the bcrypt hash the backend stored."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "pm.test('Role matches', () => pm.expect(body.admin.role).to.eql(pm.collectionVariables.get('newAdminRole')));",
        "if (pm.response.code === 200) pm.collectionVariables.set('newAdminToken', body.accessToken);"
      ] } }]
    },
    {
      "name": "4. Reject register without token (Group-12-Backend)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "noauth" },
        "url": "{{backendUrl}}/admins",
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Admin\",\n  \"email\": \"no-token@admin.com\",\n  \"password\": \"NoTokenPassword123!\",\n  \"role\": \"finance\"\n}", "options": { "raw": { "language": "json" } } }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Returns 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "5. Reject register by non-super admin (Group-12-Backend)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{newAdminToken}}", "type": "string" }] },
        "url": "{{backendUrl}}/admins",
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Forbidden\",\n  \"email\": \"forbidden@admin.com\",\n  \"password\": \"ForbiddenPassword123!\",\n  \"role\": \"finance\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Run with newAdminRole set to operations or finance. Expects 403."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Returns 403', () => pm.response.to.have.status(403));"
      ] } }]
    },
    {
      "name": "6. Reject login with wrong password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}", "options": { "raw": { "language": "json" } } }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Returns 401', () => pm.response.to.have.status(401));",
        "pm.test('No token', () => pm.expect(pm.response.json()).not.to.have.property('accessToken'));"
      ] } }]
    },
    {
      "name": "7. Register client",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Client\",\n  \"ssn\": \"123-45-6789\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"phoneNumber\": \"202-456-1111\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Creates a real client row. Use a unique email outside ADMIN_EMAIL_DOMAINS and a unique SSN."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Returns 201', () => pm.response.to.have.status(201));",
        "pm.test('No secrets exposed', () => {",
        "  const body = pm.response.json();",
        "  pm.expect(body).not.to.have.property('passwordHash');",
        "  pm.expect(body).not.to.have.property('ssn');",
        "});"
      ] } }]
    },
    {
      "name": "8. Login (client)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Any email outside ADMIN_EMAIL_DOMAINS is checked against the clients table. Logs in the client that request 7 registered."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const body = pm.response.json();",
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "pm.test('JWT returned without secrets', () => {",
        "  pm.expect(body.accessToken).to.be.a('string');",
        "  pm.expect(body.refreshToken).to.be.a('string');",
        "  pm.expect(body.client).not.to.have.property('passwordHash');",
        "  pm.expect(body.client).not.to.have.property('ssn');",
        "});",
        "if (pm.response.code === 200) pm.collectionVariables.set('clientRefreshToken', body.refreshToken);"
      ] } }]
    },
    {
      "name": "9. Refresh client access token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/refresh",
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{clientRefreshToken}}\"\n}", "options": { "raw": { "language": "json" } } }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Returns a new access token', () => {",
        "  pm.response.to.have.status(200);",
        "  pm.expect(pm.response.json().accessToken).to.be.a('string');",
        "  pm.expect(pm.response.json().refreshToken).to.be.a('string');",
        "});",
        "if (pm.response.code === 200) pm.collectionVariables.set('clientRefreshToken', pm.response.json().refreshToken);"
      ] } }]
    },
    {
      "name": "10. Logout client",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/logout",
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{clientRefreshToken}}\"\n}", "options": { "raw": { "language": "json" } } },
        "description": "Revokes the active refresh token and clears the refresh cookie. Access JWTs remain valid until expiry."
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Logout succeeds', () => pm.response.to.have.status(200));",
        "pm.test('Logout confirms completion', () => pm.expect(pm.response.json().message).to.eql('Logged out'));",
        "if (pm.response.code === 200) pm.collectionVariables.set('clientRefreshToken', '');"
      ] } }]
    }
  ]
}
