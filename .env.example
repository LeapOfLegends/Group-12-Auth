# Application Port
PORT=3000

# Shared PostgreSQL database (same one Group-12-Backend uses)
DB_HOST=localhost
DB_PORT=15432
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=capstone2026

# JWT Configuration. JWT_SECRET must be at least 32 characters and identical in Group-12-Backend.
JWT_SECRET=replace_with_a_long_random_signing_secret_of_32_or_more_characters
JWT_EXPIRATION=3600s

# Email domains that log in against the admins table (must match Group-12-Backend)
ADMIN_EMAIL_DOMAINS=admin.com,fmr.com
